{
  "name": "slotpilot",
  "private": true,
  "version": "1.0.0",
  "description": "AI-assisted appointment booking SaaS prototype (React + Express + PostgreSQL + Gemini)",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm run dev -w @slotpilot/api\" \"npm run dev -w @slotpilot/web\"",
    "build": "npm run build -w @slotpilot/shared && npm run build -w @slotpilot/api && npm run build -w @slotpilot/web",
    "start": "npm run start -w @slotpilot/api",
    "db:migrate": "npm run db:migrate -w @slotpilot/api",
    "db:seed": "npm run db:seed -w @slotpilot/api",
    "db:reset": "npm run db:reset -w @slotpilot/api",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.63.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
