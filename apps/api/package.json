{
  "name": "@slotpilot/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=development --env-file-if-exists=../../.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/db/migrate.js && node dist/db/seed.js --if-empty && node dist/server.js",
    "db:migrate": "tsx --conditions=development --env-file-if-exists=../../.env src/db/migrate.ts",
    "db:seed": "tsx --conditions=development --env-file-if-exists=../../.env src/db/seed.ts",
    "db:reset": "tsx --conditions=development --env-file-if-exists=../../.env src/db/reset.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ai-live": "tsx --conditions=development --env-file-if-exists=../../.env scripts/ai-live-smoke.ts"
  },
  "dependencies": {
    "@slotpilot/shared": "1.0.0",
    "bcryptjs": "^3.0.2",
    "cookie": "^1.0.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "luxon": "^3.7.2",
    "pg": "^8.16.3",
    "pino": "^10.0.0",
    "pino-http": "^11.0.0",
    "socket.io": "^4.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/luxon": "^3.7.1",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.3",
    "pino-pretty": "^13.1.2",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "vitest": "^3.2.4"
  }
}
