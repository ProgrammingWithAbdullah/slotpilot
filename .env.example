# Copy to .env and fill in. .env is git-ignored; never commit real secrets.

# --- server ---
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Dev only (CORS for the Vite dev server). In production the API serves the web app itself.
CLIENT_ORIGIN=http://localhost:5173

# --- database ---
DATABASE_URL=postgres://slotpilot:slotpilot@localhost:5432/slotpilot
TEST_DATABASE_URL=postgres://slotpilot:slotpilot@localhost:5432/slotpilot_test
# Force TLS on/off. By default TLS is used when the URL contains sslmode=require (e.g. Neon).
# DATABASE_SSL=true
# DB_POOL_MAX=10

# --- auth ---
# At least 32 characters. Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_EXPIRES_IN_HOURS=24

# --- tenant ---
DEFAULT_BUSINESS_SLUG=bright-smile-dental

# --- AI ---
# "gemini" (needs a key) or "mock" (offline, deterministic: used by tests and CI).
# With gemini and no key, the app still runs and the chat hands users to the booking form.
AI_PROVIDER=mock
GEMINI_API_KEY=
# First model is preferred; the next ones are tried when it is overloaded or unavailable.
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-flash-lite-latest
AI_TIMEOUT_MS=8000

# --- rate limits (defaults shown) ---
# RATE_LIMIT_GLOBAL_PER_15MIN=600
# RATE_LIMIT_AUTH_PER_15MIN=20
# RATE_LIMIT_CHAT_PER_MIN=20
# RATE_LIMIT_BOOKING_PER_HOUR=30

# --- production (set automatically in the Docker image) ---
# WEB_DIST_DIR=apps/web/dist
